# ======================================

# ⚙️ Django Application Configuration

# ======================================

SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ======================================

# 🗄️ PostgreSQL Database Configuration

# ======================================

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ======================================

# 🧠 Redis Configuration (Broker + Cache)

# ======================================

REDIS_HOST=redis
REDIS_PORT=6379

# ======================================

# 🐇 Celery Configuration

# ======================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ======================================

# 📊 Grafana Configuration

# ======================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ======================================

# 🚨 Alertmanager / Notification Channels

# ======================================

# ALERT_SLACK_WEBHOOK=[https://hooks.slack.com/services/xxxx/yyyy/zzzz](https://hooks.slack.com/services/xxxx/yyyy/zzzz)

# ALERTMANAGER_EMAIL=[alerts@example.com](mailto:alerts@example.com)

# ======================================

# 🧪 Monitoring / Prometheus (Optional)

# ======================================

PROMETHEUS_SCRAPE_INTERVAL=15s

# ======================================

# 🌐 Django Settings Module

# ======================================

DJANGO_SETTINGS_MODULE=observability_project.settings

# ======================================

# 🧰 Miscellaneous (Optional / Advanced)

# ======================================

# LOG_LEVEL=INFO

# TZ=UTC
